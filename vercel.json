{
    "redirects": [
        {
            "source": "/auth",
            "has": [
                {
                    "type": "host",
                    "value": "tabe.software"
                }
            ],
            "destination": "https://www.tabe.com.ar/registro",
            "permanent": true
        },
        {
            "source": "/auth",
            "has": [
                {
                    "type": "host",
                    "value": "www.tabe.software"
                }
            ],
            "destination": "https://www.tabe.com.ar/registro",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "tabe.software"
                }
            ],
            "destination": "https://www.tabe.com.ar/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.tabe.software"
                }
            ],
            "destination": "https://www.tabe.com.ar/$1",
            "permanent": true
        },
        {
            "source": "/auth",
            "has": [
                {
                    "type": "host",
                    "value": "tabe-oficial.vercel.app"
                }
            ],
            "destination": "https://www.tabe.com.ar/registro",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "tabe-oficial.vercel.app"
                }
            ],
            "destination": "https://www.tabe.com.ar/$1",
            "permanent": true
        },
        {
            "source": "/auth",
            "destination": "/registro",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api/|sw\\.js|version\\.json|manifest\\.json|robots\\.txt|sitemap\\.xml|ads\\.txt).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/((?!api/campus-proxy).*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=*, microphone=*, geolocation=()" }
            ]
        },
        {
            "source": "/api/campus-proxy",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
                { "key": "Access-Control-Allow-Headers", "value": "*" },
                { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                { "key": "Content-Type", "value": "application/xml" }
            ]
        },
        {
            "source": "/robots.txt",
            "headers": [
                { "key": "Content-Type", "value": "text/plain" }
            ]
        },
        {
            "source": "/ads.txt",
            "headers": [
                { "key": "Content-Type", "value": "text/plain" }
            ]
        },
        {
            "source": "/(sw.js|version.json|index.html|manifest.json|manifest.webmanifest)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Expires", "value": "0" },
                { "key": "Service-Worker-Allowed", "value": "/" }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        }
    ]
}
