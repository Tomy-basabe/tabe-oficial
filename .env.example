# Supabase - Frontend (Public / Anon key only)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# NEVER commit the following keys - they should only be set in Supabase Dashboard or CI/CD secrets:
# SUPABASE_ACCESS_TOKEN (Management API)
# SUPABASE_SERVICE_ROLE_KEY (Server-side only)
# GROQ_API_KEY (Edge functions only - set via Supabase Secrets)
